# SMTP Gmail used to send Career App verification codes.
# SMTP_PASS must be a Google app password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=Career App <your-address@gmail.com>

# Optional: development recipient override.
# If set, every verification email is sent to this address.
AUTH_EMAIL_TO=

# Optional local settings
PORT=8787
PORT_RETRY_COUNT=4

# Supabase Postgres connection (Project Settings > Database > Connection string > URI).
# Leave empty to keep using the embedded local PGlite database instead.
DATABASE_URL=

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application).
# Same client ID is used server-side (token verification) and client-side (VITE_ prefix, see career-web-react/.env for Vite).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional AI CV extraction.
# none = local fallback only. groq = Groq Cloud. xai/grok = xAI Grok. openai = OpenAI API.
AI_PROVIDER=none
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=45000
