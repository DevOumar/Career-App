# Clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modèle Groq utilisé pour la génération
GROQ_MODEL=llama-3.3-70b-versatile

# Nom du modèle d'embedding sentence-transformers (multilingue)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Chemins locaux (valeurs par défaut, à adapter si besoin)
CORPUS_PATH=data/processed/corpus.jsonl
VECTORDB_PATH=vectordb
COLLECTION_NAME=entretiens
